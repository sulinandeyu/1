{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XiaoSu Photography Reference",
  "type": "object",
  "required": ["id", "license", "originalPath", "editedPath", "goals", "validation"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "license": {
      "type": "object",
      "required": ["owner", "grant", "evidencePath"],
      "properties": {
        "owner": {"type": "string"},
        "grant": {"type": "string"},
        "evidencePath": {"type": "string"}
      }
    },
    "originalPath": {"type": "string"},
    "editedPath": {"type": "string"},
    "adjustmentRecordPath": {"type": "string"},
    "photographerNotes": {"type": "string"},
    "sceneAnalysis": {"type": "object"},
    "goals": {"type": "array", "items": {"type": "string"}},
    "protectedRegions": {"type": "array", "items": {"type": "string"}},
    "validation": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "reviewer": {"type": "string"},
        "date": {"type": "string"},
        "decision": {"enum": ["pending", "accepted", "rejected"]},
        "notes": {"type": "string"}
      }
    }
  }
}
